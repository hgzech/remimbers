{
  "indexes": [
    {
      "comment": "The daily queue: due, unsuspended cards in due order.",
      "collectionGroup": "cards",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "suspended", "order": "ASCENDING" },
        { "fieldPath": "due", "order": "ASCENDING" }
      ]
    },
    {
      "comment": "Library view: most recent notes first.",
      "collectionGroup": "notes",
      "queryScope": "COLLECTION",
      "fields": [{ "fieldPath": "createdAt", "order": "DESCENDING" }]
    }
  ],
  "fieldOverrides": []
}
