# Copy to .env.local and fill in from:
#   Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup
#
# NONE of these are secrets. They are public identifiers that ship in the
# JS bundle by design. Security comes from Firestore rules + the allowlist,
# not from hiding these. It is safe to commit them / put them in a public repo.
#
# The OpenAI key is NOT here and must never be. It lives in Google Secret
# Manager, set with:  firebase functions:secrets:set OPENAI_API_KEY

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the deployed Cloud Functions, no trailing slash.
# e.g. https://europe-west1-remimbers-xxxxx.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=
