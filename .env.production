# Committed on purpose.
#
# Every value here is a PUBLIC identifier. Firebase web config ships inside the
# JS bundle no matter what you do - anyone can read it out of the deployed app
# with devtools. It is not a credential and hiding it buys nothing. Access
# control lives entirely in firestore.rules + the allowlist collection.
#
# Committing it means CI needs no configuration and a fresh clone builds.
#
# The OpenAI key is NOT here and never will be. It lives in Google Secret
# Manager:  firebase functions:secrets:set OPENAI_API_KEY

VITE_FIREBASE_API_KEY=AIzaSyDi5RVzVCfK8pVlzDG9Ncoex0L74lKMkqs
VITE_FIREBASE_AUTH_DOMAIN=remimbers.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=remimbers
VITE_FIREBASE_STORAGE_BUCKET=remimbers.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=163645686977
VITE_FIREBASE_APP_ID=1:163645686977:web:7b4e1e640a924de642c040

# Filled in at the end of Phase 1, once Functions are deployed.
VITE_FUNCTIONS_BASE_URL=
